BASE_URL=https://www.hepsiburada.com
TEST_USER=
TEST_PASSWORD=
BROWSER=chromium
HEADLESS=false
WORKERS=2
API_BASE_URL=http://127.0.0.1:3001
API_USER=testuser
API_PASSWORD=testpass
MOCK_PORT=3001
BROWSER_EXECUTABLE=
AUTH_STATE=.auth/hepsiburada.json
# Chromium runs on the installed Google Chrome. Leave empty to use Playwright's bundled Chromium.
BROWSER_CHANNEL=chrome
# Optional overrides for `npm run auth`
CHROME_PATH=
CHROME_DEBUG_PORT=9222
# Pause (ms) after highlighting the chosen product / seller so it can be seen while watching. Default 1500 headed, 0 headless.
DEMO_PAUSE_MS=1500
# Print how long each step of the UI scenario takes
TIMING=
# Override the cart page address (default: the real Hepsiburada cart)
CART_URL=
# How long (ms) the "Diğer satıcılar" section may take to render before a product counts as single-seller
SELLER_SECTION_WAIT_MS=

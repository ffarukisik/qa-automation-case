{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "@playwright/test"],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist"
  },
  "include": [
    "pages/**/*.ts",
    "steps/**/*.ts",
    "api/**/*.ts",
    "mock-server/**/*.ts",
    "support/**/*.ts",
    "scripts/**/*.ts",
    "playwright.config.ts"
  ]
}
